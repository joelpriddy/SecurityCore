<#@ template language="C#" debug="true" hostspecific="true" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="Microsoft.EntityFrameworkCore" #>
<#@ import namespace="Microsoft.EntityFrameworkCore.Design" #>
<#@ import namespace="Microsoft.EntityFrameworkCore.Metadata" #>
<#@ import namespace="Microsoft.Extensions.DependencyInjection" #>

<#
    // Dynamically resolve EF Core assemblies
    string nugetPackagesPath = Environment.GetEnvironmentVariable("NUGET_PACKAGES") ??
                               Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".nuget", "packages");

    string efCoreDesignPath = Path.Combine(nugetPackagesPath, "microsoft.entityframeworkcore.design", "8.0.11", "lib", "net8.0", "Microsoft.EntityFrameworkCore.Design.dll");
    string efCorePath = Path.Combine(nugetPackagesPath, "microsoft.entityframeworkcore", "8.0.11", "lib", "net8.0", "Microsoft.EntityFrameworkCore.dll");

    Host.ResolveAssembly(efCoreDesignPath);
    Host.ResolveAssembly(efCorePath);

    string environment = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Production";

    if (environment != "Development") 
    {
        throw new InvalidOperationException("Scaffolding is only allowed in the development environment.");
    }

    var envPath = @"C:\Users\JoelPriddy\source\joelpriddy\TestFiles\Security\devsecrets.json";
    var encryption = new EncryptionService();
    var service = new EncryptedSecretService(null, encryption);

    if (!File.Exists(envPath))
    {
        throw new FileNotFoundException($"The environment file was not found at path: {envPath}");
    }

    // Initialize services

    string dbHost = service.GetSecret("DB_HOST") ?? string.Empty;
    string dbName = service.GetSecret("DB_NAME") ?? string.Empty;
    string dbUser = service.GetSecret("DB_USER") ?? string.Empty;
    string dbPassword = service.GetSecret("DB_PASSWORD") ?? string.Empty;

    if(dbHost == string.Empty || dbName == string.Empty || dbUser == string.Empty || dbPassword == string.Empty)
    {
        throw new InvalidOperationException("Scaffolding is only allowed if the machine contains a file with the appropriate credentials.");
    }

    string connectionString = $"Server={dbHost};Database={dbName};User={dbUser};Password={dbPassword};";

    // Scaffold the database schema
    var scaffolder = new ReverseEngineerScaffolder();
    var scaffoldedModel = scaffolder.ScaffoldModel(
        connectionString,
        new MySqlDesignTimeServices(),
        "Pomelo.EntityFrameworkCore.MySql",
        new ModelCodeGenerationOptions
        {
            ContextName = "YourDbContext",
            ContextDir = "./DbContext",
            ModelNamespace = "YourNamespace.Models",
            ContextNamespace = "YourNamespace.DbContext"
        });

    // Generate DbContext
    WriteLine(scaffoldedModel.ContextFile.Code);
    
    // Generate entity models
    foreach (var entityFile in scaffoldedModel.AdditionalFiles)
    {
        WriteLine(entityFile.Code);
    }
#>

